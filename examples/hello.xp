using = <<strng.xp>>

main => int32 {
    name := "Dimas";
    speed := 999;

    @show(sys::out) {
        "Log: User {0} has a speed of {1} ns\n";
        0 => name;
        1 => speed;
    };

    show(sys::out, "Hello, {name}! Speed: {speed}\n");
    show(sys::out, "Precision format: {speed as f64:.2}\n");

    yield 0;
}