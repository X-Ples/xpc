main => int32 {
    count := 0;
    loop {
        count = count + 1;
        if count == 5 { break; }
    }
    show(sys::out, "Infinite loop stopped at count = {count}\n");

    i := 0;
    loop i < 8 {
        i = i + 1;
    }
    show(sys::out, "Conditional loop until i = {i}\n");

    total := 0;
    for k in 0..10 {
        total = total + k;
    }
    show(sys::out, "Sum 0..10 (exclusive) = {total}\n");

    inclusive := 0;
    for k in 1..=10 {
        inclusive = inclusive + k;
    }
    show(sys::out, "Sum 1..=10 (inclusive) = {inclusive}\n");

    numbers := [10, 20, 30, 40];
    filtered_sum := 0;
    for num in numbers {
        if num == 30 { continue; }
        filtered_sum = filtered_sum + num;
    }
    show(sys::out, "Array iteration (skip 30) = {filtered_sum}\n");

    score := 85;
    if score >= 90 {
        show(sys::out, "Grade: A\n");
    } else if score >= 75 {
        show(sys::out, "Grade: B\n");
    } else {
        show(sys::out, "Grade: C\n");
    }

    yield 0;
}