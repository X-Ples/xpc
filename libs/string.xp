pub fn length(s: string) -> int32 {
    yield len(s);
}

pub fn to_upper(s: string) -> string {
    yield to_upper(s);
}

pub fn to_lower(s: string) -> string {
    yield to_lower(s);
}

pub fn trim(s: string) -> string {
    yield trim(s);
}

pub fn contains(s: string, sub: string) -> bool {
    yield contains(s, sub);
}

pub fn replace(s: string, old: string, new: string) -> string {
    result := replace(s, old, new);
    yield result;
}

pub fn concat(a: string, b: string) -> string {
    yield a + b;
}

pub fn repeat(s: string, n: int32) -> string {
    result := "";
    for i in 0..n {
        result = result + s;
    }
    yield result;
}

pub fn char_at(s: string, i: int32) -> string {
    yield s[i];
}