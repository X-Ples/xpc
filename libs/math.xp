pub const PI: f64 = 3.141592653589793;
pub const E: f64 = 2.718281828459045;
const INTERNAL_PI: f64 = 3.141592653589793;

pub fn sin(x: f64) -> f64 {
    hasil := __builtin_fast_sin(x);
    yield hasil;
}

pub fn cos(x: f64) -> f64 {
    hasil := __builtin_fast_cos(x);
    yield hasil;
}

pub fn tan(x: f64) -> f64 {
    hasil := __builtin_fast_tan(x);
    yield hasil;
}

pub fn sin_deg(derajat: f64) -> f64 {
    radian := (derajat * INTERNAL_PI / 180.0);
    yield __builtin_fast_sin(radian);
}

pub fn cos_deg(derajat: f64) -> f64 {
    radian := (derajat * INTERNAL_PI / 180.0);
    yield __builtin_fast_cos(radian);
}

pub fn deg_to_rad(derajat: f64) -> f64 {
    yield (derajat * INTERNAL_PI / 180.0);
}

pub fn rad_to_deg(radian: f64) -> f64 {
    yield (radian * 180.0 / INTERNAL_PI);
}

pub fn ln(x: f64) -> f64 {
    yield __builtin_fast_ln(x);
}

pub fn log10(x: f64) -> f64 {
    hasil := __builtin_fast_log(x);
    yield hasil;
}

pub fn exp(x: f64) -> f64 {
    yield __builtin_fast_exp(x);
}

pub fn sqrt(x: f64) -> f64 {
    yield __builtin_fast_sqrt(x);
}

pub fn dot(v1: vec4, v2: vec4) -> f64 {
    hasil_dot := v1 .x v2;
    yield hasil_dot;
}

pub fn abs(x: f64) -> f64 {
    yield abs(x);
}

pub fn pow(a: f64, b: f64) -> f64 {
    yield a ^ b;
}

pub fn max(a: f64, b: f64) -> f64 {
    guard a >= b else { yield b; }
    yield a;
}

pub fn min(a: f64, b: f64) -> f64 {
    guard a <= b else { yield b; }
    yield a;
}