pub const OUTPUT: int32 = 1;
pub const INPUT: int32 = 0;
pub const HIGH: int32 = 1;
pub const LOW: int32 = 0;

pub fn mode(pin: int32, m: int32) {
    __gpio_mode(pin, m);
}

pub fn write(pin: int32, val: int32) {
    __gpio_write(pin, val);
}

pub fn read(pin: int32) -> int32 {
    yield __gpio_read(pin);
}

pub fn toggle(pin: int32) -> int32 {
    yield __gpio_toggle(pin);
}